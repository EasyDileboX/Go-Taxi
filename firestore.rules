// Firestore rules (sample) - copy into Firebase console -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - authenticated users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rides collection - enforce passengersCount <= 12 on create
    match /rides/{rideId} {
      allow create: if request.auth != null
                    && request.resource.data.passengersCount is int
                    && request.resource.data.passengersCount > 0
                    && request.resource.data.passengersCount <= 12;

      // Read allowed for authenticated parties; update rules should be tightened in production
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Driver locations - only the driver may write to their own location doc
    match /driverLocations/{driverId} {
      allow write: if request.auth != null && request.auth.uid == driverId;
      allow read: if request.auth != null;
    }
  }
}
